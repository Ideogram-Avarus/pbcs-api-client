# Settings for the integration tests. Copy to .env, or set them as
# environment variables (they take precedence over .env).
# The library itself never reads these: pass them to Pbcs in your code.
# The scripts (python -m pbcs_api_client <script>) read the
# PBCS_IDENTITY_DOMAIN_URL ... PBCS_OAUTH_SCOPE ones for options left out.
#
# Point the tests at a test instance, never production. They only read data
# (unless PBCS_TEST_ALLOW_WRITES is set), but exporting a form updates the
# page PBCS remembers for the user.
# Tests whose settings are missing are skipped.

PBCS_URL=https://<instance>.pbcs.<region>.oraclecloud.com
PBCS_APPLICATION=
PBCS_TIMEOUT_SECONDS=30

# Optional: only the basic auth test uses these.
PBCS_USERNAME=
PBCS_PASSWORD=

# OAuth 2, used by all the integration tests. Create the refresh token once,
# from this folder, with:
#   python -m pbcs_api_client login
# It is saved to .pbcs-tokens/refresh_token. Run it again when it expires
# (7 days unused by default).
PBCS_IDENTITY_DOMAIN_URL=https://idcs-<id>.identity.oraclecloud.com
PBCS_CLIENT_ID=
PBCS_OAUTH_SCOPE=

# Forms tests: a form with one page dimension, a row dimension, and a
# column dimension. Example values are from Oracle's Vision sample app.
PBCS_TEST_FORM=
PBCS_TEST_PAGE_DIMENSION=Entity
PBCS_TEST_PAGE_MEMBER=410
PBCS_TEST_ROW_DIMENSION=Account
PBCS_TEST_COLUMN_DIMENSION=Period
PBCS_TEST_COLUMN_MEMBER=Jan

# Dimensions tests: a plan type with more than 3 dimensions, and one of its
# dimensions.
PBCS_TEST_PLAN_TYPE=Plan1
PBCS_TEST_DIMENSION=Entity

# Plan types tests use the forms settings above. Set to 1 to also write the
# form's values back to the cube unchanged. Values the form shows rounded or
# formatted would then be saved that way: only use a disposable test instance.
PBCS_TEST_ALLOW_WRITES=
